# --- DATABASE CONFIGURATION ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=citas_inventory
DB_USER=citas_admin
DB_PASSWORD=your_secure_password_here

# --- SERVER RUNTIME ---
PORT=8080
ENVIRONMENT=production
ENCRYPTION_KEY=your_32_character_master_key_here

# --- JWT & AUTHENTICATION ---
JWT_ISSUER=https://citacomsys.cloud
JWT_AUDIENCE=citas_clients
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_DEVICE_SECRET=your_jwt_device_secret_here

# --- CLOUDFLARE R2 STORAGE ---
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=citas-builds
CDN_BASE_URL=https://download.citacomsys.cloud

# --- SMS GATEWAY ( अफ्रीका's टॉकिंग / Hubtel ) ---
SMS_API_KEY=your_sms_api_key
SMS_USERNAME=your_sms_username
SMS_SENDER_ID=CITAS

# --- EMAIL GATEWAY ( Resend ) ---
RESEND_API_KEY=your_resend_api_key
SUPPORT_EMAIL=support@citacomsys.cloud

# --- TAILSCALE ---
TAILSCALE_API_KEY=your_tailscale_api_key
TAILSCALE_TAILNET=citacomsys.com