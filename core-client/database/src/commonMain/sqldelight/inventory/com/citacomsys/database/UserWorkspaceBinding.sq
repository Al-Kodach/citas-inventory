import kotlin.time.Instant;

CREATE TABLE UserWorkspaceBindingEntity (
    id TEXT NOT NULL PRIMARY KEY,
    user_id TEXT NOT NULL,
    workspace_id TEXT NOT NULL,
    workspace_name TEXT NOT NULL ,
    branch_id TEXT,
    branch_name TEXT,
    role TEXT NOT NULL,
    capabilities TEXT NOT NULL,
    is_active INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    created_at TEXT AS Instant NOT NULL,
    updated_at TEXT AS Instant NOT NULL
);

CREATE INDEX idx_user_binding_ws ON UserWorkspaceBindingEntity(workspace_id, is_active);
CREATE INDEX idx_user_binding_user ON UserWorkspaceBindingEntity(user_id);

insertOrReplace:
INSERT OR REPLACE INTO UserWorkspaceBindingEntity
VALUES ?;

selectByWorkspace:
SELECT * FROM UserWorkspaceBindingEntity WHERE workspace_id = ? AND is_active = 1;

selectByUser:
SELECT * FROM UserWorkspaceBindingEntity WHERE user_id = ? AND is_active = 1;

countActiveStaffByWorkspace:
SELECT COUNT(*) FROM UserWorkspaceBindingEntity
WHERE workspace_id = :workspaceId
  AND is_active = 1
  AND LOWER(role) != 'owner'
  AND LOWER(role) != 'organization_admin';

deleteById:
DELETE FROM UserWorkspaceBindingEntity WHERE id = ?;
