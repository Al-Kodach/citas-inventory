import kotlin.time.Instant;
import kotlin.Boolean;

-- ==============================================================================
-- RAW BACKEND MANAGEMENT SCHEMA (Heavy Batch Context)
-- ==============================================================================
CREATE TABLE StockBatchEntity (
    id TEXT PRIMARY KEY,
    workspace_id TEXT NOT NULL,
    branch_id TEXT NOT NULL,
    product_id TEXT NOT NULL REFERENCES ProductItemEntity(id),
    expiry_date TEXT,
    expiry_date_ms INTEGER,
    batch_number TEXT NOT NULL,
    initial_quantity INTEGER NOT NULL DEFAULT 0,
    current_quantity INTEGER NOT NULL DEFAULT 0,

    -- Price context
    cost_price_amount_minor INTEGER NOT NULL,
    cost_price_currency TEXT NOT NULL,
    price_update_reason TEXT DEFAULT NULL,

    selling_price_amount_minor INTEGER NOT NULL,
    selling_price_currency TEXT NOT NULL,
    has_movements INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,

    created_at TEXT AS Instant NOT NULL,
    updated_at TEXT AS Instant NOT NULL,
    is_deleted INTEGER AS Boolean NOT NULL DEFAULT 0,
    actor_id TEXT NOT NULL
);

CREATE INDEX idx_batch_product ON StockBatchEntity(product_id);
CREATE INDEX idx_batch_branch ON StockBatchEntity(branch_id);
CREATE INDEX idx_batch_updated_at ON StockBatchEntity(updated_at);


-- ==========================================
-- WRITES
-- ==========================================

insertOrReplace:
INSERT OR REPLACE INTO StockBatchEntity
VALUES ?;

updateBatchMetadata:
UPDATE StockBatchEntity SET
    batch_number = ?,
    expiry_date = ?,
    expiry_date_ms = ?,
    updated_at = ?
WHERE id = ?;

updateCostPrice:
UPDATE StockBatchEntity SET
  cost_price_amount_minor = ?,
  cost_price_currency = ?,
  price_update_reason = ?,
  actor_id = ?,
  updated_at = ?
WHERE id = ?;

updatePrice:
UPDATE StockBatchEntity
SET selling_price_amount_minor = ?,
    selling_price_currency = ?,
    actor_id = ?,
    updated_at = ?
WHERE id = ?;

updateHasMovement:
UPDATE StockBatchEntity
SET has_movements = 1
WHERE id IN :batchIds;


-- ==========================================
-- READS
-- ==========================================

selectById:
SELECT * FROM StockBatchEntity WHERE id = ?;

selectByBatchNo:
SELECT * FROM StockBatchEntity
WHERE product_id = ? AND batch_number = ?;


-- ==========================================
-- CLEANUP / MAINTENANCE
-- ==========================================

countActive:
SELECT COUNT(*) FROM StockBatchEntity WHERE is_deleted = 0 AND branch_id = ?;

deleteById:
DELETE FROM StockBatchEntity WHERE id = ?;

deleteAll:
DELETE FROM StockBatchEntity;

markAllBatchesAsDeletedForProduct:
UPDATE StockBatchEntity SET is_deleted = 1 WHERE product_id = :productId;

softDeleteWithScrumble:
UPDATE StockBatchEntity SET
    batch_number = batch_number || '_del_' || id,
    is_deleted = 1,
    actor_id = :actorId,
    updated_at = :updatedAt
WHERE id = :id;
